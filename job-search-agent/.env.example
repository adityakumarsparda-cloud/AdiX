# Copy to .env and fill in. NEVER commit .env.

# --- Backend ---
DATABASE_URL=sqlite:///./data/app.db
FRONTEND_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
MAX_DAILY_OUTREACH=20

# --- Ollama (local, free; optional — system degrades gracefully without it) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# --- Gmail (Phase 5/7) ---
# Create an OAuth *Desktop app* client in Google Cloud Console, download
# credentials.json into backend/ (git-ignored). Minimal scopes only:
#   gmail.compose + gmail.readonly
# GMAIL_CREDENTIALS_PATH=./credentials.json
# GMAIL_TOKEN_PATH=./gmail.token.json

# --- Frontend ---
BACKEND_URL=http://localhost:8000
