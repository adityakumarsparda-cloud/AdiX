# Copy to .env and fill in from https://www.linkedin.com/developers/apps -> Auth tab
# .env is gitignored. Never commit real values.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match a URL listed under "Authorized redirect URLs" in the Auth tab
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback
PORT=3000

# Optional. Only needed if your token carries w_member_social but not openid/profile,
# which makes /v2/userinfo unavailable for looking up your member id.
LINKEDIN_PERSON_ID=

# Optional. Pins the LinkedIn-Version header instead of negotiating one automatically.
LINKEDIN_API_VERSION=

# --- Google storage-by-app dashboard (npm run google) ---
# From https://console.cloud.google.com/apis/credentials -> OAuth client ID
# -> "Web application". Enable the Drive API and the Gmail API on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must be listed under "Authorized redirect URIs" on the same OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3100/callback
GOOGLE_PORT=3100

# Optional. Gmail has no mailbox-size endpoint, so size is summed one message at
# a time; this caps the scan and anything beyond it is extrapolated.
GOOGLE_GMAIL_SCAN_LIMIT=2000
